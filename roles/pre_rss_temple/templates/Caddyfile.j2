{
	email {{ pre_rss_temple__ca_email }}
}

{{ _pre_rss_temple__server_domains | map('regex_replace', '^', 'https://') | join(", ") }} {
	log

	encode gzip

	reverse_proxy caddy-rss_temple:8000
}

{{ _pre_rss_temple__server_domains | map('regex_replace', '^', 'http://') | join(", ") }} {
	respond "The API is only accessible over HTTPS" 403 {
		close
	}
}

{{ _pre_rss_temple__web_app_domains | join(", ") }} {
	log

	encode gzip

	reverse_proxy caddy-rss_temple_web_app:4200
}

{{ _pre_rss_temple__home_domains | join(", ") }} {
	log

	encode gzip

	reverse_proxy caddy-rss_temple_home:3000
}
