x-rss-temple-image: &rss-temple-image
  image: 'murraychristopherson/rss_temple:{{ rss_temple__docker_version }}'

x-rss-temple-depends-on: &rss-temple-depends-on
  depends_on:
    {{ rss_temple__app_docker_service_prefix }}postgresql:
      condition: service_healthy
    {{ rss_temple__app_docker_service_prefix }}valkey:
      condition: service_healthy
    {{ rss_temple__app_docker_service_prefix }}rss_temple_migrate:
      condition: service_completed_successfully

services:
  {{ rss_temple__app_docker_service_prefix }}valkey:
    image: valkey/valkey:8-alpine
    command: valkey-server /usr/local/etc/valkey/valkey.conf
    restart: always
    volumes:
      - valkey_data:/data/
      - ./overrides/valkey.conf:/usr/local/etc/valkey/valkey.conf
    networks:
      - rss_temple_net
    healthcheck:
      test: ['CMD-SHELL', '[ "$$(valkey-cli ping)" = PONG ]']
      interval: 5s
      timeout: 5s
      retries: 6
      start_period: 30s
  {{ rss_temple__app_docker_service_prefix }}postgresql:
    image: postgres:18-alpine
    restart: always
    shm_size: '256m'
    expose:
      - '5432'
    env_file:
      - .env
    volumes:
{% if not rss_temple__postgres_local_var_directory %}
      - db_data:/var/lib/postgresql/
{% else %}
      - {{ rss_temple__postgres_local_var_directory }}:/var/lib/postgresql/
{% endif %}
    networks:
      - rss_temple_net
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -h 127.0.0.1 -U "$${POSTGRES_USER:-postgres}" -d "$${POSTGRES_DB:-postgres}"']
      interval: 5s
      timeout: 5s
      retries: 6
      start_period: 60s
  {{ rss_temple__app_docker_service_prefix }}caddy-rss_temple:
    image: caddy:2-alpine
    restart: always
    expose:
      - '8000'
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data/
      - django_static:/srv/
    networks:
      - rss_temple_net
      - global_rss_temple_net
  # One-shot: applies migrations, then exits. The long-running services wait for it to finish successfully
  {{ rss_temple__app_docker_service_prefix }}rss_temple_migrate:
    <<: *rss-temple-image
    command: python ./manage.py migrate
    depends_on:
      {{ rss_temple__app_docker_service_prefix }}postgresql:
        condition: service_healthy
    environment:
      APP_IN_DOCKER: 'true'
    env_file:
      - .env
    volumes:
      - ./overrides/local_settings.py:/code/rss_temple/local_settings.py
    networks:
      - rss_temple_net
  # One-shot: copies static files into the volume Caddy serves, then exits
  {{ rss_temple__app_docker_service_prefix }}rss_temple_collectstatic:
    <<: *rss-temple-image
    command: python ./manage.py collectstatic --noinput
    environment:
      APP_IN_DOCKER: 'true'
    env_file:
      - .env
    volumes:
      - ./overrides/local_settings.py:/code/rss_temple/local_settings.py
      - django_static:/code/_static/
    networks:
      - rss_temple_net
  {{ rss_temple__app_docker_service_prefix }}rss_temple:
    <<: *rss-temple-image
    command: gunicorn -b 0.0.0.0:8000 rss_temple.wsgi:application
    depends_on:
      {{ rss_temple__app_docker_service_prefix }}postgresql:
        condition: service_healthy
      {{ rss_temple__app_docker_service_prefix }}valkey:
        condition: service_healthy
      {{ rss_temple__app_docker_service_prefix }}rss_temple_migrate:
        condition: service_completed_successfully
      {{ rss_temple__app_docker_service_prefix }}rss_temple_collectstatic:
        condition: service_completed_successfully
    restart: always
    environment:
      APP_IN_DOCKER: 'true'
{% if rss_temple__app_malloc_conf %}
      MALLOC_CONF: {{ rss_temple__app_malloc_conf | quote }}
{% endif %}
    env_file:
      - .env
    volumes:
      - ./overrides/local_settings.py:/code/rss_temple/local_settings.py
      - ./overrides/gunicorn.conf.py:/code/gunicorn.conf.py
    networks:
      - default  # necessary, because functionality requires making calls to the external internet
      - rss_temple_net
  {{ rss_temple__app_docker_service_prefix }}rss_temple_dramatiq:
    <<: [*rss-temple-image, *rss-temple-depends-on]
    command: dramatiq api_dramatiq.main -Q rss_temple
    restart: always
    environment:
      APP_IN_DOCKER: 'true'
{% if rss_temple__dramatiq_malloc_conf %}
      MALLOC_CONF: {{ rss_temple__dramatiq_malloc_conf | quote }}
{% endif %}
    env_file:
      - .env
    volumes:
      - ./overrides/local_settings.py:/code/rss_temple/local_settings.py
    networks:
      - default  # necessary, because functionality requires making calls to the external internet
      - rss_temple_net
  {{ rss_temple__app_docker_service_prefix }}rss_temple_schedulerdaemon:
    <<: [*rss-temple-image, *rss-temple-depends-on]
    command: >
      sh -c "
        python ./manage.py checkclassifierlabels

        exec python ./manage.py schedulerdaemon /schedulerdaemon.json
      "
    restart: always
    environment:
      APP_IN_DOCKER: 'true'
{% if rss_temple__schedulerdaemon_malloc_conf %}
      MALLOC_CONF: {{ rss_temple__schedulerdaemon_malloc_conf | quote }}
{% endif %}
    env_file:
      - .env
    volumes:
      - ./schedulerdaemon.json:/schedulerdaemon.json
      - ./overrides/local_settings.py:/code/rss_temple/local_settings.py
    networks:
      - rss_temple_net
volumes:
  valkey_data:
{% if not rss_temple__postgres_local_var_directory %}
  db_data:
{% endif %}
  caddy_data:
  django_static:
networks:
  global_rss_temple_net:
    external: true
  rss_temple_net:
    internal: true
